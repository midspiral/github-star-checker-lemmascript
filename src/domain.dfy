  ensures forall k: nat :: ((k < |current|) ==> !(containsId(previous, current[k].id)) ==> exists j: nat :: ((j < |res.added|) && (res.added[j] == current[k])))
  ensures forall j: nat :: ((j < |res.removed|) ==> exists k: nat :: (((k < |previous|) && (res.removed[j] == previous[k])) && !(containsId(current, res.removed[j].id))))
  ensures forall k: nat :: ((k < |previous|) ==> !(containsId(current, previous[k].id)) ==> exists j: nat :: ((j < |res.removed|) && (res.removed[j] == previous[k])))
{
  var previousIds: set<string> := {};
  var p := 0;
  while (p < |previous|)
    invariant (p <= |previous|)
    invariant forall k: nat :: ((k < p) ==> (previous[k].id in previousIds))
    invariant forall id :: ((id in previousIds) ==> exists k: nat :: ((k < p) && (previous[k].id == id)))
    decreases (|previous| - p)
  {
    previousIds := (previousIds + {previous[p].id});
    p := (p + 1);
  }
  var currentIds: set<string> := {};
  var c := 0;
  while (c < |current|)
    invariant (c <= |current|)
    invariant forall k: nat :: ((k < c) ==> (current[k].id in currentIds))
    invariant forall id :: ((id in currentIds) ==> exists k: nat :: ((k < c) && (current[k].id == id)))
    decreases (|current| - c)
  {
    currentIds := (currentIds + {current[c].id});
    c := (c + 1);
  }
  var added: seq<Stargazer> := [];
  var i := 0;
  while (i < |current|)
    invariant (i <= |current|)
    invariant (|added| <= i)
    invariant forall j: nat :: ((j < |added|) ==> exists k: nat :: (((k < i) && (added[j] == current[k])) && !(containsId(previous, added[j].id))))
    invariant forall k: nat :: ((k < i) ==> !(containsId(previous, current[k].id)) ==> exists j: nat :: ((j < |added|) && (added[j] == current[k])))
    decreases (|current| - i)
  {
    if !((current[i].id in previousIds)) {
      added := (added + [current[i]]);
    }
    i := (i + 1);
  }
  var removed: seq<Stargazer> := [];
  var r := 0;
  while (r < |previous|)
    invariant (r <= |previous|)
    invariant (|removed| <= r)
    invariant forall j: nat :: ((j < |removed|) ==> exists k: nat :: (((k < r) && (removed[j] == previous[k])) && !(containsId(current, removed[j].id))))
    invariant forall k: nat :: ((k < r) ==> !(containsId(current, previous[k].id)) ==> exists j: nat :: ((j < |removed|) && (removed[j] == previous[k])))
    decreases (|previous| - r)
  {
    if !((previous[r].id in currentIds)) {
      removed := (removed + [previous[r]]);
    }
