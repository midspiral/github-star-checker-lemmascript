datatype Stargazer = Stargazer(id: string, login: string, starredAt: string)

datatype StargazerDiff = StargazerDiff(added: seq<Stargazer>, removed: seq<Stargazer>)

function containsId(stargazers: seq<Stargazer>, id: string): bool
  decreases |stargazers|
{
  if (|stargazers| == 0) then
    false
  else
    ((stargazers[0].id == id) || containsId(stargazers[1..], id))
}

method diffStargazers(previous: seq<Stargazer>, current: seq<Stargazer>) returns (res: StargazerDiff)
